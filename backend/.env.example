NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (identity provider only — see docs/04-auth-security.md)
# Find your Project URL and keys at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use EITHER SUPABASE_JWKS_URL (asymmetric ECC/RS256 — current Supabase default)
# OR SUPABASE_JWT_SECRET (legacy HS256). Do not set both.
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=<your-jwt-secret-from-supabase-settings-api>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key-from-supabase-settings-api>
# Anon key — used server-side to exchange the refresh-token cookie for a fresh access token
# in POST /api/auth/refresh (silent session renewal). Same value as the frontend's anon key.
SUPABASE_ANON_KEY=<your-anon-key-from-supabase-settings-api>

# MongoDB (system of record)
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI=mongodb://localhost:27017/itap

# Redis (BullMQ + rate limiting)
# Upstash (TLS): rediss://default:<password>@<host>:6379
# Local:         redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Session cookies issued by Express (see docs/04-auth-security.md §3)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=<generate-a-64-char-random-hex-string>
SESSION_COOKIE_TTL_MINUTES=15
REFRESH_COOKIE_TTL_DAYS=7

# AI microservice (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Super-admin panel (/admin-panel). Comma-separated allowlist of emails permitted to become
# platform super-admins — the ONLY way an admin account is provisioned (no open signup).
# Leave blank to disable admin access entirely. See docs/13 §6.
SUPER_ADMIN_EMAILS=
# Shared secret between the Node API and the AI service. Leave empty in dev.
AI_SERVICE_TOKEN=

# LLM provider adapter (see ai-service/.env.example for the actual keys)
