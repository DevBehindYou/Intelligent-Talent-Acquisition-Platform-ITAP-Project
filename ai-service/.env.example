# LLM provider adapter — Ollama-first, pluggable (docs/01-technical-architecture.md §1.3)
LLM_PROVIDER=ollama              # "ollama" | "openai_compatible" | "anthropic" | "none"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vector search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Shared secret with the Node API. When set, requests without a matching X-AI-Service-Token
# header are rejected (401). Must equal the API's AI_SERVICE_TOKEN. Leave blank in local dev.
AI_SERVICE_TOKEN=
# Optional comma-separated CORS origins. Leave blank — this service is called server-to-server.
AI_CORS_ALLOW_ORIGINS=
